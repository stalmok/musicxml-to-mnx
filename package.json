{
  "name": "mnxml",
  "version": "0.0.0",
  "description": "Convert MusicXML to MNX, the W3C JSON music notation format.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stalmok/mnxml.git"
  },
  "type": "module",
  "main": "./dist/mnxml.js",
  "module": "./dist/mnxml.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mnxml.js",
      "default": "./dist/mnxml.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "musicxml",
    "mnx",
    "music",
    "notation",
    "converter",
    "sheet-music",
    "score"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@rgrove/parse-xml": "4.2.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.9",
    "ajv": "8.20.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
