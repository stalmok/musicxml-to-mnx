{
  "name": "musicxml-to-mnx",
  "version": "0.1.1",
  "description": "Convert MusicXML to MNX, the W3C JSON music notation format.",
  "license": "MIT",
  "author": "Kestutis Stalmok",
  "homepage": "https://github.com/stalmok/musicxml-to-mnx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stalmok/musicxml-to-mnx.git"
  },
  "bugs": {
    "url": "https://github.com/stalmok/musicxml-to-mnx/issues"
  },
  "type": "module",
  "main": "./dist/musicxml-to-mnx.js",
  "module": "./dist/musicxml-to-mnx.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/musicxml-to-mnx.js",
      "default": "./dist/musicxml-to-mnx.js"
    },
    "./schema/mnx-schema.json": "./schema/mnx-schema.json"
  },
  "files": [
    "dist",
    "schema/mnx-schema.json",
    "schema/PROVENANCE.md"
  ],
  "sideEffects": false,
  "keywords": [
    "musicxml",
    "mnx",
    "music",
    "music-notation",
    "converter",
    "sheet-music",
    "score"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "vite build && vite build --config vite.cli.config.ts && tsc -p tsconfig.build.json && node scripts/prune-declarations.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:precommit": "vitest run --coverage --exclude '**/corpus.test.ts' --exclude '**/performance.test.ts'",
    "test:corpus": "vitest run tests/corpus.test.ts",
    "test:perf": "vitest run tests/performance.test.ts",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deps:check": "depcruise src cli tests --output-type err-long",
    "format": "node scripts/prettier.ts --write .",
    "format:check": "node scripts/prettier.ts --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "corpus-gate": "vitest run tests/corpus-full.test.ts"
  },
  "dependencies": {
    "@rgrove/parse-xml": "5.0.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "bin": {
    "musicxml-to-mnx": "dist/cli.js"
  }
}
