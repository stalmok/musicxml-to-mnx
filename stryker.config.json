{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins_comment": "Named one by one because the default glob resolves plugins by scanning a flat node_modules, which pnpm does not give it: under pnpm the run starts with no runner and no checker loaded, and the only symptom is an 'unknown config option' warning for the runner's own settings.",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.stryker.json",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/fraction.ts",
    "src/read/duration.ts",
    "src/read/divisions.ts",
    "src/read/voices.ts",
    "src/read/spanners.ts"
  ],
  "mutator": {
    "excludedMutations": ["StringLiteral", "Regex"]
  },
  "concurrency": 6,
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/report.json" },
  "clearTextReporter": { "maxTestsToLog": 1 },
  "thresholds": { "high": 90, "low": 75, "break": null },
  "tempDirName": ".stryker-tmp"
}
