#!/bin/sh
# Pre-commit gate: typecheck, lint, formatting, and the test suite (with its
# coverage thresholds) must all pass before a commit is created. Mirrors the
# manual workflow in AGENTS.md so broken code can't slip through.
#
# The test step excludes the vendored corpus, which converts every vendored
# song on every run and takes minutes; the fast suite still holds coverage
# above its thresholds. The vendored corpus runs in CI on pushes and pull
# requests that change what it tests, and before each release. Run it locally
# with pnpm test:coverage or pnpm test:corpus.
#
# Version-controlled here and activated per clone with:
#   pnpm hooks:install      # = git config core.hooksPath .githooks
set -e

echo "pre-commit → pnpm typecheck"
pnpm typecheck

echo "pre-commit → pnpm lint"
pnpm lint

echo "pre-commit → pnpm deps:check"
pnpm deps:check

echo "pre-commit → pnpm format:check"
pnpm format:check

echo "pre-commit → pnpm test:precommit"
pnpm test:precommit
