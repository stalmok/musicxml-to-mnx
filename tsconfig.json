{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Neither DOM nor Node: the library is pure data transformation and runs
    // in both, so it must not reach for either one's globals. This config
    // covers src alone, which is what keeps that guarantee honest. The tests
    // are Node programs and are checked by tsconfig.test.json instead.
    "lib": ["ES2022"],
    "types": [],

    "strict": true,
    "noUnusedLocals": true,
    // Unused *parameters* are allowed only when prefixed with _.
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Stricter than the renderer's config, for two reasons specific to a
    // converter: index access is everywhere in tree walking, and its results
    // genuinely can be missing (a <measure> may have no <note>); and MNX
    // output distinguishes an absent key from one set to undefined, which
    // exactOptionalPropertyTypes enforces at the type level.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Library source only. The tests are Node programs and are checked by
  // tsconfig.test.json, which is what lets this pass enforce the rule above.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
